<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Atlas.App.Resources"
             xmlns:vm="using:Atlas.App.ViewModels"
             x:Class="Atlas.App.Views.HistoryPageView"
             x:DataType="vm:HistoryPageViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1144" />
            </Grid.ColumnDefinitions>
            <StackPanel Classes="page">
                <TextBlock Classes="page-title" Text="{x:Static res:Strings.HistoryTitle}" />
                <TextBlock Classes="secondary" MaxWidth="720" HorizontalAlignment="Left" Text="{x:Static res:Strings.HistoryIntro}" />

                <StackPanel Spacing="8" IsVisible="{Binding LoadError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <SelectableTextBlock Classes="error" Text="{Binding LoadError}" />
                    <Button Content="{x:Static res:Strings.Retry}" Command="{Binding LoadCommand}" />
                </StackPanel>

                <TextBlock x:Name="HistoryEmpty" Classes="body" Text="{x:Static res:Strings.HistoryEmpty}" IsVisible="{Binding IsEmpty}" Margin="0,8,0,0" />

                <ItemsControl x:Name="HistoryItems" ItemsSource="{Binding Items}" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HistoryItemViewModel">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24" Margin="0,6">
                                <SelectableTextBlock Classes="body" Classes.error="{Binding IsProblem}" Text="{Binding Text}" />
                                <TextBlock Grid.Column="1" Classes="caption" VerticalAlignment="Center" Text="{Binding When}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
