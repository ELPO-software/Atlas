<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Atlas.App.Resources"
             xmlns:vm="using:Atlas.App.ViewModels"
             x:Class="Atlas.App.Views.HomePageView"
             x:DataType="vm:HomePageViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="860" />
            </Grid.ColumnDefinitions>
            <StackPanel Classes="page">
                <StackPanel Spacing="6">
                    <TextBlock Classes="page-title" Text="{x:Static res:Strings.HomeTitle}" />
                    <TextBlock x:Name="WorkspaceCount" Classes="secondary" Text="{Binding WorkspaceCountText}" />
                </StackPanel>

                <Border Classes="infobar error" IsVisible="{Binding LoadError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Path Classes="icon" Data="{StaticResource IconWarning}" />
                        <SelectableTextBlock Grid.Column="1" Classes="body" Text="{Binding LoadError}" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="{x:Static res:Strings.Retry}" Command="{Binding LoadCommand}" />
                    </Grid>
                </Border>

                <!-- Atlas asks once before it observes anything. -->
                <Border x:Name="HomeDetectionInvite" Classes="panel" IsVisible="{Binding IsDetectionUndecided}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Border Classes="tile top">
                            <Path Classes="icon" Data="{StaticResource IconDetect}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock Classes="section-title" Text="{x:Static res:Strings.DetectionInviteTitle}" />
                            <TextBlock Classes="secondary" FontSize="13" Text="{x:Static res:Strings.DetectionInviteText}" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                                <Button x:Name="HomeEnableDetection"
                                        Classes="primary"
                                        Content="{x:Static res:Strings.EnableDetection}"
                                        Command="{Binding EnableDetectionCommand}" />
                                <Button x:Name="HomeDeclineDetection"
                                        Classes="quiet"
                                        Content="{x:Static res:Strings.NotNow}"
                                        Command="{Binding DeclineDetectionCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="HomeSuggestions" Classes="infobar" IsVisible="{Binding HasSuggestions}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Path Classes="icon" Data="{StaticResource IconSuggestions}" />
                        <TextBlock Grid.Column="1" Classes="strong" VerticalAlignment="Center" Text="{Binding SuggestionsWaitingText}" />
                        <Button Grid.Column="2" Content="{x:Static res:Strings.ViewSuggestions}" Command="{Binding OpenSuggestionsCommand}" />
                    </Grid>
                </Border>

                <Border Classes="panel">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="section-title" Text="{x:Static res:Strings.QuickCreateTitle}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox x:Name="NewWorkspaceName"
                                     Text="{Binding NewWorkspaceName}"
                                     PlaceholderText="{x:Static res:Strings.QuickCreatePlaceholder}"
                                     AutomationProperties.Name="{x:Static res:Strings.QuickCreatePlaceholder}">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding QuickCreateCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                            <Button x:Name="QuickCreate"
                                    Grid.Column="1"
                                    Classes="primary"
                                    Content="{x:Static res:Strings.Create}"
                                    Command="{Binding QuickCreateCommand}" />
                        </Grid>
                        <TextBlock x:Name="NewWorkspaceError"
                                   Classes="error"
                                   Text="{Binding NewWorkspaceError}"
                                   IsVisible="{Binding NewWorkspaceError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </Border>

                <StackPanel Classes="empty" IsVisible="{Binding IsEmpty}">
                    <Border Classes="empty-icon">
                        <Path Classes="icon" Data="{StaticResource IconWorkspaces}" />
                    </Border>
                    <TextBlock Classes="secondary" Text="{x:Static res:Strings.HomeEmptyMessage}" />
                </StackPanel>

                <TextBlock Classes="section-title spaced" Text="{x:Static res:Strings.RecentTitle}" IsVisible="{Binding HasRecents}" />
                <ItemsControl x:Name="Recents" ItemsSource="{Binding Recents}" Margin="-12,-6,-12,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:WorkspaceCardViewModel">
                            <Button Classes="row"
                                    Command="{Binding OpenCommand}"
                                    AutomationProperties.Name="{Binding OpenLabel}">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14">
                                    <Border Classes="tile">
                                        <Path Classes="icon" Data="{StaticResource IconWorkspaces}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Classes="strong"
                                                   Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding Name}" />
                                        <TextBlock Classes="caption" Text="{Binding ResourceCountText}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Classes="caption"
                                               Text="{Binding ModifiedText}"
                                               VerticalAlignment="Center" />
                                    <Path Grid.Column="3" Classes="icon small" Data="{StaticResource IconChevron}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
