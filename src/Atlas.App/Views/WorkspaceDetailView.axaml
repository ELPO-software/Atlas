<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Atlas.App.Resources"
             xmlns:vm="using:Atlas.App.ViewModels"
             x:Class="Atlas.App.Views.WorkspaceDetailView"
             x:DataType="vm:WorkspaceDetailViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1144" />
            </Grid.ColumnDefinitions>
            <StackPanel Classes="page">
                <Button x:Name="Back"
                        Classes="quiet"
                        Margin="-8,0,0,0"
                        Command="{Binding BackCommand}"
                        AutomationProperties.Name="{x:Static res:Strings.BackToWorkspaces}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Path Classes="icon" Data="{StaticResource IconBack}" />
                        <TextBlock Classes="secondary" Text="{x:Static res:Strings.BackToWorkspaces}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <SelectableTextBlock x:Name="LoadError"
                                     Classes="error"
                                     Text="{Binding LoadError}"
                                     IsVisible="{Binding LoadError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <StackPanel Spacing="12" IsVisible="{Binding IsLoaded}">
                    <StackPanel Spacing="4">
                        <SelectableTextBlock x:Name="WorkspaceName" Classes="page-title" Text="{Binding Name}" />
                        <SelectableTextBlock x:Name="WorkspaceDescription"
                                             Classes="secondary"
                                             MaxWidth="720"
                                             HorizontalAlignment="Left"
                                             Text="{Binding Description}"
                                             IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                            <TextBlock Classes="caption" Text="{Binding CreatedText}" />
                            <TextBlock x:Name="ModifiedDate" Classes="caption" Text="{Binding ModifiedText}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button x:Name="RestoreWorkspace"
                                Classes="primary"
                                Content="{x:Static res:Strings.Restore}"
                                Command="{Binding RestoreCommand}"
                                IsEnabled="{Binding CanRestore}" />
                        <Button x:Name="EditWorkspace" Content="{x:Static res:Strings.Edit}" Command="{Binding EditCommand}" IsEnabled="{Binding CanChange}" />
                        <Button x:Name="DuplicateWorkspace" Content="{x:Static res:Strings.Duplicate}" Command="{Binding DuplicateCommand}" IsEnabled="{Binding CanChange}" />
                        <Button x:Name="DeleteWorkspace" Classes="danger-text" Content="{x:Static res:Strings.Delete}" Command="{Binding DeleteCommand}" IsEnabled="{Binding CanChange}" />
                    </StackPanel>

                    <SelectableTextBlock x:Name="ActionError"
                                         Classes="error"
                                         Text="{Binding ActionError}"
                                         IsVisible="{Binding ActionError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <Border x:Name="RestoreProgress" Classes="surface" IsVisible="{Binding IsRestoring}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="RestoreProgressText" Text="{Binding RestoreProgressText}" TextTrimming="CharacterEllipsis" />
                                <ProgressBar Minimum="0" Maximum="{Binding RestoreTotal}" Value="{Binding RestoreCompleted}" />
                            </StackPanel>
                            <Button x:Name="StopRestore"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Content="{x:Static res:Strings.StopRestore}"
                                    Command="{Binding StopRestoreCommand}" />
                        </Grid>
                    </Border>

                    <Border x:Name="RestoreReport" Classes="surface" Padding="16" IsVisible="{Binding HasReport}">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="ReportTitle" Classes="strong" FontSize="16" Text="{Binding Report.Title}" />
                                    <TextBlock x:Name="ReportSummary" Classes="secondary" Text="{Binding Report.Summary}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Classes="quiet"
                                        VerticalAlignment="Top"
                                        Content="{x:Static res:Strings.CloseReport}"
                                        Command="{Binding CloseReportCommand}" />
                            </Grid>
                            <ItemsControl x:Name="ReportLines" ItemsSource="{Binding Report.Lines}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="10" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RestoreLineViewModel">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Classes="caption" Text="{Binding Detail}" TextWrapping="Wrap" IsVisible="{Binding HasDetail}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Classes="strong"
                                                       Classes.error="{Binding IsProblem}"
                                                       VerticalAlignment="Top"
                                                       Text="{Binding Status}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static res:Strings.RestoreMeaning}" />
                        </StackPanel>
                    </Border>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,16,0,0">
                        <TextBlock Classes="section-title" VerticalAlignment="Center" Text="{x:Static res:Strings.ResourcesTitle}" />
                        <Button x:Name="AddResource"
                                Grid.Column="1"
                                Content="{x:Static res:Strings.AddResource}"
                                Command="{Binding AddResourceCommand}"
                                IsEnabled="{Binding CanChange}" />
                    </Grid>
                    <TextBlock x:Name="NoResources"
                               Classes="secondary"
                               Text="{x:Static res:Strings.NoResourcesToRestore}"
                               IsVisible="{Binding HasNoResources}" />
                    <ItemsControl x:Name="ResourceGroups" ItemsSource="{Binding ResourceGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ResourceGroupViewModel">
                                <StackPanel Spacing="6" Margin="0,0,0,12">
                                    <TextBlock Classes="strong" Text="{Binding Title}" />
                                    <Border Classes="surface">
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="10" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ResourceItemViewModel">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Classes="caption strong"
                                                                           VerticalAlignment="Center"
                                                                           Text="{x:Static res:Strings.NeedsApprovalBadge}"
                                                                           IsVisible="{Binding NeedsApproval}" />
                                                            </StackPanel>
                                                            <TextBlock Classes="caption"
                                                                       Text="{Binding Target}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip.Tip="{Binding Target}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                            <Button Classes="quiet"
                                                                    Content="{x:Static res:Strings.Edit}"
                                                                    Command="{Binding EditCommand}"
                                                                    IsEnabled="{Binding $parent[UserControl].((vm:WorkspaceDetailViewModel)DataContext).CanChange}"
                                                                    AutomationProperties.Name="{Binding EditLabel}" />
                                                            <Button Classes="quiet"
                                                                    Content="{x:Static res:Strings.Remove}"
                                                                    Command="{Binding RemoveCommand}"
                                                                    IsEnabled="{Binding $parent[UserControl].((vm:WorkspaceDetailViewModel)DataContext).CanChange}"
                                                                    AutomationProperties.Name="{Binding RemoveLabel}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,16,0,0">
                        <TextBlock Classes="section-title" Text="{x:Static res:Strings.NotesTitle}" />
                        <TextBlock x:Name="NotesStatus"
                                   Grid.Column="1"
                                   Classes="caption"
                                   VerticalAlignment="Center"
                                   Text="{Binding NotesStatus}" />
                    </Grid>
                    <TextBox x:Name="Notes"
                             Text="{Binding Notes}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="180"
                             MaxHeight="480"
                             PlaceholderText="{x:Static res:Strings.NotesPlaceholder}"
                             AutomationProperties.Name="{x:Static res:Strings.NotesTitle}" />
                    <StackPanel Spacing="8" IsVisible="{Binding NotesError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <SelectableTextBlock x:Name="NotesError" Classes="error" Text="{Binding NotesError}" />
                        <Button Content="{x:Static res:Strings.Retry}" Command="{Binding RetrySaveNotesCommand}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
