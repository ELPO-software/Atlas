<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Atlas.App.Controls"
             xmlns:res="using:Atlas.App.Resources"
             xmlns:vm="using:Atlas.App.ViewModels"
             x:Class="Atlas.App.Views.WorkspaceDetailView"
             x:DataType="vm:WorkspaceDetailViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1000" />
            </Grid.ColumnDefinitions>
            <StackPanel Classes="page">
                <Button x:Name="Back"
                        Classes="quiet"
                        Margin="-8,0,0,0"
                        HorizontalAlignment="Left"
                        Command="{Binding BackCommand}"
                        AutomationProperties.Name="{x:Static res:Strings.BackToWorkspaces}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Path Classes="icon small" Data="{StaticResource IconBack}" />
                        <TextBlock Classes="secondary" FontSize="13" Text="{x:Static res:Strings.BackToWorkspaces}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border Classes="infobar error" IsVisible="{Binding LoadError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Path Classes="icon" Data="{StaticResource IconWarning}" />
                        <SelectableTextBlock x:Name="LoadError" Grid.Column="1" Classes="body" Text="{Binding LoadError}" />
                    </Grid>
                </Border>

                <ProgressBar Classes="thin" IsIndeterminate="True" IsVisible="{Binding IsLoading}" />

                <StackPanel Spacing="16" IsVisible="{Binding IsLoaded}">
                    <StackPanel Spacing="6">
                        <SelectableTextBlock x:Name="WorkspaceName" Classes="page-title" Text="{Binding Name}" />
                        <SelectableTextBlock x:Name="WorkspaceDescription"
                                             Classes="secondary"
                                             MaxWidth="720"
                                             HorizontalAlignment="Left"
                                             Text="{Binding Description}"
                                             IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="caption" Text="{Binding CreatedText}" />
                            <TextBlock Classes="caption" Text="·" />
                            <TextBlock x:Name="ModifiedDate" Classes="caption" Text="{Binding ModifiedText}" />
                        </StackPanel>
                    </StackPanel>

                    <WrapPanel Orientation="Horizontal">
                        <Button x:Name="RestoreWorkspace"
                                Classes="primary"
                                Margin="0,0,8,8"
                                Command="{Binding RestoreCommand}"
                                IsEnabled="{Binding CanRestore}"
                                AutomationProperties.Name="{x:Static res:Strings.Restore}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Classes="icon small" Data="{StaticResource IconPlay}" />
                                <TextBlock Text="{x:Static res:Strings.Restore}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="EditWorkspace" Margin="0,0,8,8" Content="{x:Static res:Strings.Edit}" Command="{Binding EditCommand}" IsEnabled="{Binding CanChange}" />
                        <Button x:Name="DuplicateWorkspace" Margin="0,0,8,8" Content="{x:Static res:Strings.Duplicate}" Command="{Binding DuplicateCommand}" IsEnabled="{Binding CanChange}" />
                        <Button x:Name="ExportWorkspace" Margin="0,0,8,8" Command="{Binding ExportCommand}" IsEnabled="{Binding CanChange}" AutomationProperties.Name="{x:Static res:Strings.Export}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Classes="icon small" Data="{StaticResource IconExport}" />
                                <TextBlock Text="{x:Static res:Strings.Export}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DeleteWorkspace" Margin="0,0,8,8" Classes="danger-text" Content="{x:Static res:Strings.Delete}" Command="{Binding DeleteCommand}" IsEnabled="{Binding CanChange}" />
                    </WrapPanel>

                    <Border Classes="infobar error" IsVisible="{Binding ActionError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Path Classes="icon" Data="{StaticResource IconWarning}" />
                            <SelectableTextBlock x:Name="ActionError" Grid.Column="1" Classes="body" Text="{Binding ActionError}" />
                        </Grid>
                    </Border>

                    <Border Classes="infobar success" IsVisible="{Binding ActionInfo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Path Classes="icon" Data="{StaticResource IconCheck}" />
                            <SelectableTextBlock x:Name="ActionInfo" Grid.Column="1" Classes="body" Text="{Binding ActionInfo}" />
                        </Grid>
                    </Border>

                    <Border x:Name="RestoreProgress" Classes="panel" IsVisible="{Binding IsRestoring}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="RestoreProgressText" Text="{Binding RestoreProgressText}" TextTrimming="CharacterEllipsis" />
                                <ProgressBar Minimum="0" Maximum="{Binding RestoreTotal}" Value="{Binding RestoreCompleted}" />
                            </StackPanel>
                            <Button x:Name="StopRestore"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Content="{x:Static res:Strings.StopRestore}"
                                    Command="{Binding StopRestoreCommand}" />
                        </Grid>
                    </Border>

                    <Border x:Name="RestoreReport" Classes="panel" IsVisible="{Binding HasReport}">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="ReportTitle" Classes="section-title" Text="{Binding Report.Title}" />
                                    <TextBlock x:Name="ReportSummary" Classes="secondary" Text="{Binding Report.Summary}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Classes="quiet"
                                        VerticalAlignment="Top"
                                        Content="{x:Static res:Strings.CloseReport}"
                                        Command="{Binding CloseReportCommand}" />
                            </Grid>
                            <ItemsControl x:Name="ReportLines" ItemsSource="{Binding Report.Lines}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="10" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RestoreLineViewModel">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Classes="caption" Text="{Binding Detail}" TextWrapping="Wrap" IsVisible="{Binding HasDetail}" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Classes="chip success" Classes.success="{Binding !IsProblem}" Classes.warning="{Binding IsProblem}" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Status}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static res:Strings.RestoreMeaning}" />
                        </StackPanel>
                    </Border>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                        <TextBlock Classes="section-title" VerticalAlignment="Center" Text="{x:Static res:Strings.ResourcesTitle}" />
                        <Button x:Name="AddResource"
                                Grid.Column="1"
                                Command="{Binding AddResourceCommand}"
                                IsEnabled="{Binding CanChange}"
                                AutomationProperties.Name="{x:Static res:Strings.AddResource}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Classes="icon small" Data="{StaticResource IconPlus}" />
                                <TextBlock Text="{x:Static res:Strings.AddResource}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="NoResources"
                               Classes="secondary"
                               Text="{x:Static res:Strings.NoResourcesToRestore}"
                               IsVisible="{Binding HasNoResources}" />
                    <ItemsControl x:Name="ResourceGroups" ItemsSource="{Binding ResourceGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ResourceGroupViewModel">
                                <StackPanel Spacing="8" Margin="0,0,0,14">
                                    <TextBlock Classes="eyebrow" Text="{Binding Title}" />
                                    <Border Classes="surface" Padding="6">
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="2" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ResourceItemViewModel">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="8,6">
                                                        <Border Classes="tile" Width="32" Height="32">
                                                            <Path Classes="icon small" Data="{Binding Kind, Converter={x:Static controls:ResourceIcons.Geometry}}" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                                <Border Classes="chip warning" IsVisible="{Binding NeedsApproval}">
                                                                    <TextBlock Text="{x:Static res:Strings.NeedsApprovalBadge}" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Classes="caption"
                                                                       Text="{Binding Target}"
                                                                       TextTrimming="PathSegmentEllipsis"
                                                                       ToolTip.Tip="{Binding Target}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                            <Button Content="{x:Static res:Strings.Approve}"
                                                                    Margin="0,0,6,0"
                                                                    Command="{Binding ApproveCommand}"
                                                                    IsVisible="{Binding NeedsApproval}"
                                                                    IsEnabled="{Binding $parent[UserControl].((vm:WorkspaceDetailViewModel)DataContext).CanChange}"
                                                                    AutomationProperties.Name="{Binding ApproveLabel}" />
                                                            <Button Classes="icon-button"
                                                                    Command="{Binding EditCommand}"
                                                                    IsEnabled="{Binding $parent[UserControl].((vm:WorkspaceDetailViewModel)DataContext).CanChange}"
                                                                    ToolTip.Tip="{x:Static res:Strings.Edit}"
                                                                    AutomationProperties.Name="{Binding EditLabel}">
                                                                <Path Classes="icon small" Data="{StaticResource IconEdit}" />
                                                            </Button>
                                                            <Button Classes="icon-button"
                                                                    Command="{Binding RemoveCommand}"
                                                                    IsEnabled="{Binding $parent[UserControl].((vm:WorkspaceDetailViewModel)DataContext).CanChange}"
                                                                    ToolTip.Tip="{x:Static res:Strings.Remove}"
                                                                    AutomationProperties.Name="{Binding RemoveLabel}">
                                                                <Path Classes="icon small" Data="{StaticResource IconRemove}" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                        <TextBlock Classes="section-title" Text="{x:Static res:Strings.NotesTitle}" />
                        <TextBlock x:Name="NotesStatus"
                                   Grid.Column="1"
                                   Classes="caption"
                                   VerticalAlignment="Center"
                                   Text="{Binding NotesStatus}" />
                    </Grid>
                    <TextBox x:Name="Notes"
                             Text="{Binding Notes}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="180"
                             MaxHeight="480"
                             PlaceholderText="{x:Static res:Strings.NotesPlaceholder}"
                             AutomationProperties.Name="{x:Static res:Strings.NotesTitle}" />
                    <Border Classes="infobar error" IsVisible="{Binding NotesError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Path Classes="icon" Data="{StaticResource IconWarning}" />
                            <SelectableTextBlock x:Name="NotesError" Grid.Column="1" Classes="body" Text="{Binding NotesError}" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="{x:Static res:Strings.Retry}" Command="{Binding RetrySaveNotesCommand}" />
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                        <TextBlock Classes="section-title" VerticalAlignment="Center" Text="{x:Static res:Strings.VersionsTitle}" />
                        <Button x:Name="SaveVersion"
                                Grid.Column="1"
                                Content="{x:Static res:Strings.SaveVersion}"
                                Command="{Binding SaveVersionCommand}"
                                IsEnabled="{Binding CanChange}" />
                    </Grid>
                    <TextBlock x:Name="NoVersions"
                               Classes="secondary"
                               Text="{x:Static res:Strings.VersionsEmpty}"
                               IsVisible="{Binding HasNoVersions}" />
                    <SelectableTextBlock x:Name="VersionsError"
                                         Classes="error"
                                         Text="{Binding VersionsError}"
                                         IsVisible="{Binding VersionsError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <Border Classes="surface" Padding="6" IsVisible="{Binding !HasNoVersions}">
                        <ItemsControl x:Name="Versions" ItemsSource="{Binding Versions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:VersionItemViewModel">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="8,6">
                                        <Border Classes="tile" Width="32" Height="32">
                                            <Path Classes="icon small" Data="{StaticResource IconHistory}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <TextBlock Classes="caption" Text="{Binding SavedText}" />
                                                <TextBlock Classes="caption" Text="{Binding ResourceCountText}" />
                                                <TextBlock Classes="caption" Text="{x:Static res:Strings.AutomaticVersion}" IsVisible="{Binding IsAutomatic}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Classes="quiet"
                                                VerticalAlignment="Center"
                                                Content="{x:Static res:Strings.RestoreVersion}"
                                                Command="{Binding RestoreCommand}"
                                                IsEnabled="{Binding $parent[UserControl].((vm:WorkspaceDetailViewModel)DataContext).CanChange}"
                                                AutomationProperties.Name="{Binding RestoreLabel}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
