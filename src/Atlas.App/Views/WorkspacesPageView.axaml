<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Atlas.App.Controls"
             xmlns:res="using:Atlas.App.Resources"
             xmlns:vm="using:Atlas.App.ViewModels"
             x:Class="Atlas.App.Views.WorkspacesPageView"
             x:DataType="vm:WorkspacesPageViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1144" />
            </Grid.ColumnDefinitions>
            <StackPanel Classes="page">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="page-title" Text="{x:Static res:Strings.WorkspacesTitle}" />
                        <TextBlock Classes="secondary" Text="{Binding WorkspaceCountText}" />
                    </StackPanel>
                    <Button x:Name="NewWorkspace"
                            Grid.Column="1"
                            Classes="primary"
                            VerticalAlignment="Top"
                            Content="{x:Static res:Strings.NewWorkspace}"
                            Command="{Binding CreateCommand}" />
                </Grid>

                <StackPanel Spacing="8" IsVisible="{Binding LoadError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <SelectableTextBlock Classes="error" Text="{Binding LoadError}" />
                    <Button Content="{x:Static res:Strings.Retry}" Command="{Binding LoadCommand}" />
                </StackPanel>

                <TextBlock Classes="body" Text="{x:Static res:Strings.WorkspacesEmptyMessage}" IsVisible="{Binding IsEmpty}" Margin="0,8,0,0" />

                <ItemsControl x:Name="Cards" ItemsSource="{Binding Cards}" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:ResponsiveGrid />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:WorkspaceCardViewModel">
                            <Button Classes="card"
                                    Command="{Binding OpenCommand}"
                                    AutomationProperties.Name="{Binding OpenLabel}">
                                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="6">
                                    <TextBlock Classes="card-title" Text="{Binding Name}" ToolTip.Tip="{Binding Name}" />
                                    <TextBlock Grid.Row="1"
                                               Classes="secondary"
                                               Text="{Binding Description}"
                                               MaxLines="2"
                                               TextTrimming="CharacterEllipsis" />
                                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,8,0,0">
                                        <StackPanel Spacing="2">
                                            <TextBlock Classes="caption" Text="{Binding ResourceCountText}" />
                                            <TextBlock Classes="caption" Text="{Binding ModifiedText}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Classes="strong"
                                                   VerticalAlignment="Bottom"
                                                   Text="{x:Static res:Strings.Open}" />
                                    </Grid>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
