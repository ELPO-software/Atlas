<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Atlas.App.Controls"
             xmlns:res="using:Atlas.App.Resources"
             xmlns:vm="using:Atlas.App.ViewModels"
             x:Class="Atlas.App.Views.WorkspacesPageView"
             x:DataType="vm:WorkspacesPageViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1180" />
            </Grid.ColumnDefinitions>
            <StackPanel Classes="page">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="page-title" Text="{x:Static res:Strings.WorkspacesTitle}" />
                        <TextBlock Classes="secondary" Text="{Binding WorkspaceCountText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                        <Button x:Name="ImportWorkspace" Command="{Binding ImportCommand}" AutomationProperties.Name="{x:Static res:Strings.Import}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Classes="icon small" Data="{StaticResource IconImport}" />
                                <TextBlock Text="{x:Static res:Strings.Import}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NewWorkspace" Classes="primary" Command="{Binding CreateCommand}" AutomationProperties.Name="{x:Static res:Strings.NewWorkspace}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Classes="icon small" Data="{StaticResource IconPlus}" />
                                <TextBlock Text="{x:Static res:Strings.NewWorkspace}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Classes="infobar error" IsVisible="{Binding ImportError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Path Classes="icon" Data="{StaticResource IconWarning}" />
                        <SelectableTextBlock x:Name="ImportError" Grid.Column="1" Classes="body" Text="{Binding ImportError}" />
                    </Grid>
                </Border>

                <Border Classes="infobar error" IsVisible="{Binding LoadError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Path Classes="icon" Data="{StaticResource IconWarning}" />
                        <SelectableTextBlock Grid.Column="1" Classes="body" Text="{Binding LoadError}" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="{x:Static res:Strings.Retry}" Command="{Binding LoadCommand}" />
                    </Grid>
                </Border>

                <StackPanel Classes="empty" IsVisible="{Binding IsEmpty}">
                    <Border Classes="empty-icon">
                        <Path Classes="icon" Data="{StaticResource IconWorkspaces}" />
                    </Border>
                    <TextBlock Classes="secondary" Text="{x:Static res:Strings.WorkspacesEmptyMessage}" />
                </StackPanel>

                <ItemsControl x:Name="Cards" ItemsSource="{Binding Cards}" Margin="0,4,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:ResponsiveGrid />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:WorkspaceCardViewModel">
                            <Button Classes="card"
                                    Command="{Binding OpenCommand}"
                                    AutomationProperties.Name="{Binding OpenLabel}">
                                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Border Classes="tile">
                                            <Path Classes="icon" Data="{StaticResource IconWorkspaces}" />
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   Classes="card-title"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Name}"
                                                   ToolTip.Tip="{Binding Name}" />
                                    </Grid>
                                    <TextBlock Grid.Row="1"
                                               Classes="secondary"
                                               FontSize="13"
                                               Text="{Binding Description}"
                                               MaxLines="2"
                                               TextTrimming="CharacterEllipsis" />
                                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="2">
                                            <TextBlock Classes="caption" Text="{Binding ResourceCountText}" />
                                            <TextBlock Classes="caption" Text="{Binding ModifiedText}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Bottom">
                                            <TextBlock Classes="strong accent" FontSize="13" VerticalAlignment="Center" Text="{x:Static res:Strings.Open}" />
                                            <Path Classes="icon small" Data="{StaticResource IconChevron}" Stroke="{DynamicResource AtlasAccentTextBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
