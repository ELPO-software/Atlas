<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:Atlas.App.Resources"
        xmlns:vm="using:Atlas.App.ViewModels"
        x:Class="Atlas.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{x:Static res:Strings.AppName}"
        Width="1100" Height="720"
        MinWidth="800" MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
        <TextBlock Text="{x:Static res:Strings.AppName}"
                   FontSize="28"
                   HorizontalAlignment="Center" />
        <TextBlock x:Name="WorkspaceCount"
                   Text="{Binding WorkspaceCountText}"
                   TextWrapping="Wrap"
                   MaxWidth="560"
                   HorizontalAlignment="Center" />
    </StackPanel>
</Window>
