<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:Atlas.App.Resources"
        xmlns:views="using:Atlas.App.Views"
        xmlns:vm="using:Atlas.App.ViewModels"
        x:Class="Atlas.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{x:Static res:Strings.AppName}"
        Icon="/Assets/atlas.ico"
        Background="{DynamicResource AtlasBackgroundBrush}"
        Width="1180" Height="760"
        MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Grid ColumnDefinitions="236,*">

        <Border Background="{DynamicResource AtlasSidebarBrush}"
                BorderBrush="{DynamicResource AtlasBorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="12,18,12,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="11" Margin="10,2,8,26">
                    <Viewbox Width="30" Height="30">
                        <Canvas Width="32" Height="32">
                            <Rectangle Width="32" Height="32" RadiusX="9" RadiusY="9" Fill="{DynamicResource AtlasAccentBrush}" />
                            <Path Data="{StaticResource LogoGlyph}"
                                  Stroke="{DynamicResource AtlasOnColorBrush}"
                                  StrokeThickness="2.75"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round" />
                        </Canvas>
                    </Viewbox>
                    <StackPanel VerticalAlignment="Center" Spacing="0">
                        <TextBlock Text="{x:Static res:Strings.AppShortName}" Classes="strong" FontSize="16" LetterSpacing="-0.2" />
                        <TextBlock Text="{x:Static res:Strings.Publisher}" Classes="caption" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <Button x:Name="NavSettings"
                        DockPanel.Dock="Bottom"
                        Classes="nav"
                        Classes.selected="{Binding IsSettingsSelected}"
                        Command="{Binding OpenSettingsCommand}"
                        AutomationProperties.Name="{x:Static res:Strings.NavSettings}">
                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                        <Border Classes="nav-indicator" />
                        <Path Grid.Column="1" Classes="icon" Data="{StaticResource IconSettings}" />
                        <TextBlock Grid.Column="2" Classes="nav-label" Text="{x:Static res:Strings.NavSettings}" VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <StackPanel Spacing="2">
                    <Button x:Name="NavHome"
                            Classes="nav"
                            Classes.selected="{Binding IsHomeSelected}"
                            Command="{Binding OpenHomeCommand}"
                            AutomationProperties.Name="{x:Static res:Strings.NavHome}">
                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                            <Border Classes="nav-indicator" />
                            <Path Grid.Column="1" Classes="icon" Data="{StaticResource IconHome}" />
                            <TextBlock Grid.Column="2" Classes="nav-label" Text="{x:Static res:Strings.NavHome}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button x:Name="NavWorkspaces"
                            Classes="nav"
                            Classes.selected="{Binding IsWorkspacesSelected}"
                            Command="{Binding OpenWorkspacesCommand}"
                            AutomationProperties.Name="{x:Static res:Strings.NavWorkspaces}">
                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                            <Border Classes="nav-indicator" />
                            <Path Grid.Column="1" Classes="icon" Data="{StaticResource IconWorkspaces}" />
                            <TextBlock Grid.Column="2" Classes="nav-label" Text="{x:Static res:Strings.NavWorkspaces}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button x:Name="NavSuggestions"
                            Classes="nav"
                            Classes.selected="{Binding IsSuggestionsSelected}"
                            Command="{Binding OpenSuggestionsCommand}"
                            AutomationProperties.Name="{Binding SuggestionsNavigationLabel}">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                            <Border Classes="nav-indicator" />
                            <Path Grid.Column="1" Classes="icon" Data="{StaticResource IconSuggestions}" />
                            <TextBlock Grid.Column="2" Classes="nav-label" Text="{x:Static res:Strings.NavSuggestions}" VerticalAlignment="Center" />
                            <Border x:Name="SuggestionBadge"
                                    Grid.Column="3"
                                    Classes="badge"
                                    IsVisible="{Binding HasSuggestionBadge}">
                                <TextBlock Text="{Binding SuggestionBadgeText}" />
                            </Border>
                        </Grid>
                    </Button>
                    <Button x:Name="NavHistory"
                            Classes="nav"
                            Classes.selected="{Binding IsHistorySelected}"
                            Command="{Binding OpenHistoryCommand}"
                            AutomationProperties.Name="{x:Static res:Strings.NavHistory}">
                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                            <Border Classes="nav-indicator" />
                            <Path Grid.Column="1" Classes="icon" Data="{StaticResource IconHistory}" />
                            <TextBlock Grid.Column="2" Classes="nav-label" Text="{x:Static res:Strings.NavHistory}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">
            <Border x:Name="UnexpectedErrorBanner"
                    Classes="infobar error"
                    Margin="24,16,24,0"
                    IsVisible="{Binding UnexpectedErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Path Classes="icon" Data="{StaticResource IconWarning}" />
                    <SelectableTextBlock Grid.Column="1"
                                         Classes="body"
                                         Text="{Binding UnexpectedErrorText}"
                                         VerticalAlignment="Center" />
                    <Button Grid.Column="2"
                            Content="{x:Static res:Strings.Close}"
                            Command="{Binding DismissUnexpectedErrorCommand}" />
                </Grid>
            </Border>

            <Border x:Name="AnnouncementBanner"
                    Grid.Row="1"
                    Classes="infobar"
                    Classes.warning="{Binding !IsAnnouncementCertain}"
                    Margin="24,16,24,0"
                    IsVisible="{Binding HasAnnouncement}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Path Classes="icon" Data="{StaticResource IconDetect}" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock x:Name="AnnouncementTitle" Classes="strong" Text="{Binding AnnouncementTitle}" />
                        <TextBlock x:Name="AnnouncementMessage" Classes="body" Text="{Binding AnnouncementMessage}" />
                        <TextBlock Classes="error"
                                   Text="{Binding AnnouncementError}"
                                   IsVisible="{Binding AnnouncementError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                            <Button x:Name="AcceptAnnouncement"
                                    Classes="primary"
                                    Content="{Binding AnnouncementAcceptLabel}"
                                    Command="{Binding AcceptAnnouncementCommand}" />
                            <Button x:Name="LaterAnnouncement"
                                    Content="{x:Static res:Strings.SuggestionLater}"
                                    Command="{Binding LaterAnnouncementCommand}" />
                            <Button x:Name="IgnoreAnnouncement"
                                    Classes="quiet"
                                    Content="{x:Static res:Strings.SuggestionIgnore}"
                                    Command="{Binding IgnoreAnnouncementCommand}" />
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Classes="icon-button"
                            VerticalAlignment="Top"
                            Command="{Binding DismissAnnouncementCommand}"
                            ToolTip.Tip="{x:Static res:Strings.Close}"
                            AutomationProperties.Name="{x:Static res:Strings.Close}">
                        <Path Classes="icon small" Data="{StaticResource IconRemove}" />
                    </Button>
                </Grid>
            </Border>

            <TransitioningContentControl x:Name="PageHost" Grid.Row="2" Content="{Binding CurrentPage}">
                <TransitioningContentControl.DataTemplates>
                    <DataTemplate DataType="vm:HomePageViewModel">
                        <views:HomePageView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:WorkspacesPageViewModel">
                        <views:WorkspacesPageView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:WorkspaceDetailViewModel">
                        <views:WorkspaceDetailView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:SuggestionsPageViewModel">
                        <views:SuggestionsPageView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:HistoryPageViewModel">
                        <views:HistoryPageView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:SettingsPageViewModel">
                        <views:SettingsPageView />
                    </DataTemplate>
                </TransitioningContentControl.DataTemplates>
            </TransitioningContentControl>
        </Grid>
    </Grid>
</Window>
