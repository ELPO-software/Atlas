<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="using:Atlas.App.Services"
        x:Class="Atlas.App.Views.ConfirmationWindow"
        x:DataType="services:ConfirmationRequest"
        Title="{Binding Title}"
        Icon="/Assets/atlas.ico"
        Background="{DynamicResource AtlasBackgroundBrush}"
        Width="460"
        SizeToContent="Height"
        CanResize="False"
        CanMinimize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24" Spacing="16">
        <TextBlock x:Name="ConfirmationTitle" Classes="section-title" TextWrapping="Wrap" Text="{Binding Title}" />
        <TextBlock x:Name="ConfirmationMessage" Classes="body" Text="{Binding Message}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="CancelButton"
                    Content="{Binding CancelLabel}"
                    IsCancel="True"
                    Click="OnCancelClick" />
            <Button x:Name="ConfirmButton"
                    Classes="danger"
                    Content="{Binding ConfirmLabel}"
                    Click="OnConfirmClick" />
        </StackPanel>
    </StackPanel>
</Window>
