<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:Atlas.App.Resources"
        xmlns:vm="using:Atlas.App.ViewModels"
        x:Class="Atlas.App.Views.ImportPreviewWindow"
        x:DataType="vm:ImportPreviewViewModel"
        Title="{x:Static res:Strings.ImportTitle}"
        Icon="/Assets/atlas.ico"
        Background="{DynamicResource AtlasBackgroundBrush}"
        Width="580"
        SizeToContent="Height"
        CanResize="False"
        CanMinimize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24" Spacing="16">
        <StackPanel Spacing="4">
            <TextBlock Classes="section-title" Text="{x:Static res:Strings.ImportTitle}" />
            <TextBlock x:Name="FileName" Classes="caption" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <StackPanel Spacing="8" IsVisible="{Binding HasProblem}">
            <SelectableTextBlock x:Name="Problem" Classes="error" Text="{Binding Problem}" />
            <TextBlock Classes="body" Text="{x:Static res:Strings.ImportNothingImported}" />
        </StackPanel>

        <StackPanel Spacing="12" IsVisible="{Binding CanImport}">
            <TextBlock Classes="secondary" Text="{x:Static res:Strings.ImportIntro}" />
            <StackPanel Spacing="2">
                <TextBlock x:Name="WorkspaceName" Classes="card-title" Text="{Binding WorkspaceName}" />
                <TextBlock Classes="secondary" Text="{Binding Description}" MaxLines="3" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasDescription}" />
                <TextBlock x:Name="CountText" Classes="caption" Text="{Binding CountText}" />
            </StackPanel>
            <Border Classes="surface" IsVisible="{Binding HasItems}">
                <ScrollViewer MaxHeight="280" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="Items" ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ImportPreviewItem">
                                <StackPanel Spacing="2">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Classes="caption" Text="{Binding KindText}" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Classes="caption" Text="{Binding Target}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Target}" />
                                    <TextBlock Classes="caption strong" Classes.error="{Binding IsRefused}" Text="{Binding Note}" TextWrapping="Wrap" IsVisible="{Binding HasNote}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="CancelButton"
                    Content="{x:Static res:Strings.Cancel}"
                    IsCancel="True"
                    Click="OnCancelClick" />
            <Button x:Name="ImportButton"
                    Classes="primary"
                    Content="{x:Static res:Strings.Import}"
                    IsVisible="{Binding CanImport}"
                    Click="OnImportClick" />
        </StackPanel>
    </StackPanel>
</Window>
